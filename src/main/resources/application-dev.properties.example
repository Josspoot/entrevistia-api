# Copia este archivo como application-dev.properties y pon tus datos.
# application-dev.properties está en .gitignore: NUNCA se sube a GitHub.
server.port=8090
spring.datasource.url=jdbc:postgresql://localhost:5432/entrevistia
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_CONTRASENA

# Llave de Gemini: https://aistudio.google.com/apikey
gemini.api-key=TU_LLAVE_DE_GEMINI

# ID del proyecto de Firebase (valida los tokens de /resumes)
firebase.project-id=TU_PROYECTO_DE_FIREBASE
